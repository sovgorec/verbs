<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Aprende Verbos</title>
<style>
  body { font-family: Inter, sans-serif; background:#fafafa; color:#222; text-align:center; padding:40px; }
  select, button { padding:10px 16px; font-size:16px; margin:10px; border-radius:8px; border:1px solid #ccc; }
  .verbos { margin-top:20px; }
  .resultado { margin-top:30px; font-size:18px; line-height:1.5; }
</style>
</head>
<body>
  <h1>🇪🇸 Aprende Verbos</h1>
  <p>Selecciona el tipo de verbo:</p>

  <select id="tipo">
    <option value="">— elegir —</option>
    <option value="regular">Regulares</option>
    <option value="irregular">Irregulares</option>
  </select>

  <div class="verbos" id="verbos"></div>
  <div class="resultado" id="resultado"></div>

<script>
const data = {
  regular: {
    hablar: {
      yo:"hablo", tú:"hablas", él:"habla",
      nosotros:"hablamos", vosotros:"habláis", ellos:"hablan",
      frases:[
        "Yo hablo español.",
        "Tú hablas con tu amigo.",
        "Nosotros hablamos mucho."
      ]
    },
    comer: {
      yo:"como", tú:"comes", él:"come",
      nosotros:"comemos", vosotros:"coméis", ellos:"comen",
      frases:[
        "Yo como pan.",
        "Ellos comen en casa.",
        "Nosotros comemos juntos."
      ]
    },
    vivir: {
      yo:"vivo", tú:"vives", él:"vive",
      nosotros:"vivimos", vosotros:"vivís", ellos:"viven",
      frases:[
        "Yo vivo en Madrid.",
        "Ella vive sola.",
        "Nosotros vivimos cerca."
      ]
    }
  },
  irregular: {
    ser: {
      yo:"soy", tú:"eres", él:"es",
      nosotros:"somos", vosotros:"sois", ellos:"son",
      frases:[
        "Yo soy feliz.",
        "Tú eres amable.",
        "Ellos son estudiantes."
      ]
    },
    ir: {
      yo:"voy", tú:"vas", él:"va",
      nosotros:"vamos", vosotros:"vais", ellos:"van",
      frases:[
        "Yo voy al cine.",
        "Tú vas a casa.",
        "Nosotros vamos juntos."
      ]
    },
    tener: {
      yo:"tengo", tú:"tienes", él:"tiene",
      nosotros:"tenemos", vosotros:"tenéis", ellos:"tienen",
      frases:[
        "Yo tengo un libro.",
        "Ella tiene hambre.",
        "Nosotros tenemos tiempo."
      ]
    }
  }
};

const tipoSelect = document.getElementById("tipo");
const verbosDiv = document.getElementById("verbos");
const resultadoDiv = document.getElementById("resultado");

tipoSelect.addEventListener("change", ()=>{
  const tipo = tipoSelect.value;
  resultadoDiv.innerHTML = "";
  verbosDiv.innerHTML = "";

  if(!tipo) return;
  const verbos = Object.keys(data[tipo]);
  verbosDiv.innerHTML = verbos.map(v=>`<button onclick="mostrar('${tipo}','${v}')">${v}</button>`).join('');
});

function mostrar(tipo, verbo){
  const v = data[tipo][verbo];
  let html = `<h2>${verbo}</h2><table style="margin:0 auto"><tr><td>yo</td><td>${v.yo}</td></tr>
              <tr><td>tú</td><td>${v.tú}</td></tr>
              <tr><td>él/ella</td><td>${v.él}</td></tr>
              <tr><td>nosotros</td><td>${v.nosotros}</td></tr>
              <tr><td>vosotros</td><td>${v.vosotros}</td></tr>
              <tr><td>ellos</td><td>${v.ellos}</td></tr></table>
              <h3>Ejemplos:</h3><ul>`+
              v.frases.map(f=>`<li>${f}</li>`).join('')+
              `</ul>`;
  resultadoDiv.innerHTML = html;
}
</script>
</body>
</html>
